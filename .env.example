# Gmail OAuth2 credentials (optional - only needed for email draft feature)
# Set up at https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here

# No paid API keys required!
# LinkedIn search and email lookup use DuckDuckGo (free, no API key needed).
