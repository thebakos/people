# Gmail OAuth2 credentials (optional - only needed for email draft feature)
# Set up at https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here

# LinkedIn authentication (optional but recommended)
# Get your li_at cookie from browser DevTools > Application > Cookies > linkedin.com
# Or paste it directly in the UI when searching.
LINKEDIN_COOKIE=your_li_at_cookie_here

# No paid API keys required!
# LinkedIn search uses the Voyager API with your session cookie.
# Email lookup uses DuckDuckGo (free, no API key needed).
