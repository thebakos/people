# LinkedIn search via Proxycurl API
# Get your API key at https://nubela.co/proxycurl
PROXYCURL_API_KEY=your_proxycurl_api_key_here

# Google Custom Search (for web-based people search)
# Set up at https://console.developers.google.com/ and https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Gmail OAuth2 credentials
# Set up at https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here
